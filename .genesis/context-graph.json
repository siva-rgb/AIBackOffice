  "invariants": {
    "$comment": "Health rules that define 'not broken' for KORA. Each has a CHECK command that must be RUN, not narrated. Added by hand at genesis 2026-07-23; all four verified holding at that time.",
    "dependency_direction_inward": {
      "rule": "Services never import routers. app/routers/** may import app/services/** and app/store; the reverse is a layering violation.",
      "why": "Routers are the delivery mechanism (a detail). Business logic must stay callable from cron jobs and agent tool-calls, not just HTTP.",
      "check": "cd backend && grep -rnE '^\\s*(from|import)\\s+.*routers' app/services/ | wc -l",
      "expect": "0",
      "verified_at_genesis": "0 violations"
    },
    "every_outbound_call_has_a_timeout": {
      "rule": "Every outbound network call (LLM gateway, Supabase, Stripe, Google, Notion) sets an explicit timeout. No naked requests/httpx call without one.",
      "why": "Integration points are the #1 source of cascading failure; an untimed call turns a slow dependency into a hung worker.",
      "check": "cd backend && grep -rn 'timeout' app/services/llm.py",
      "expect": "a timeout= kwarg on the client construction / request",
      "verified_at_genesis": "app/services/llm.py:32 timeout=60.0"
    },
    "all_llm_input_is_sanitized": {
      "rule": "Untrusted text (CSV descriptions, email bodies, uploaded contracts, Notion pages, user chat) passes sanitize_prompt_input() before reaching a prompt.",
      "why": "Prompt injection is the live threat for an agent that can send email and move money. Instruction hierarchy + sanitization is the Phase 11 gate.",
      "check": "cd backend && grep -rn 'sanitize_prompt_input' app/ | wc -l",
      "expect": ">= 21 (never decreases without an explicit decision record)",
      "verified_at_genesis": "21 call sites"
    },
    "no_outbound_send_without_human_approval": {
      "rule": "No code path sends email/money without passing an explicit approval step. deliver=True is reachable only from an approve_* handler; preview, bulk, and cron paths stay draft-only.",
      "why": "This is the project's core autonomy contract (DONE.html section 1). Violating it is the single worst failure mode: mass-emailing a client list by surprise.",
      "check": "cd backend && grep -rn 'deliver=True' app/ ",
      "expect": "every hit sits inside an approval handler (today: supervisor.approve_task)",
      "verified_at_genesis": "holds - preview + cron paths default deliver=False"
    }
  },
  "freeze_boundary": [
    "backend/app/**",
    "backend/tests/**",
    "backend/migrations/**",
    "frontend/app/**",
    "frontend/components/**",
    "frontend/lib/**"
  ]
}

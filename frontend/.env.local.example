# ============================================================================
# Kora FRONTEND environment template — copy to .env.local.
# The frontend is a thin client: all data + AI live in the FastAPI backend.
# With nothing set, it talks to the backend at http://localhost:8000, which
# itself runs on mock adapters — so the whole stack boots with zero secrets.
# ============================================================================

# --- Backend API ------------------------------------------------------------
# Browser-reachable URL of the FastAPI backend (SKILL.md §3).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-side override for RSC fetches (e.g. an internal Cloud Run URL).
# KORA_API_URL=http://localhost:8000

# --- Supabase (frontend auth — public keys only) ----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# --- Stripe (publishable key + webhook stay in the frontend) ----------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
